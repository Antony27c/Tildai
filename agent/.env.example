AGENT_PRIVATE_KEY=
TEXTILE_API_KEY=
# Chats de Telegram habilitados para dar de alta (ids separados por coma; vacío = nadie nuevo)
TILDAI_ALLOWED_CHATS=
# 1 = alta abierta a cualquier chat
TILDAI_OPEN_SIGNUP=
# Máximo de altas (tx createVault) por día; default 5
TILDAI_MAX_ALTAS_DIA=
# Minutos sin minar antes de verificar si la tx de alta quedó descartada; default 30
TILDAI_ALTA_PENDIENTE_MIN=
# Pesos (wARS) por USD₮ que acepta pagar un vault nuevo al dolarizar; obligatoria en mainnet, sin default
TILDAI_MAX_RATE=
# Archivo JSONL con el registro de cada operación de plata; default data/ops.jsonl
TILDAI_OPS_FILE=
# Indexer de ventas (source of truth cuando está configurado; sin él no hay avisos de venta)
TILDAI_INDEXER_URL=
TILDAI_INDEXER_TOKEN=
# Archivo JSON con el cursor de /events ya avisados; default data/eventos.json
TILDAI_EVENTS_FILE=
