# URL pública de la página (para el QR fijo). Sin valor = se usa el host del pedido.
NEXT_PUBLIC_BASE_URL=
# Validación de vaults contra la cadena: TildaiFactory.isVault(vault).
# Dirección de la TildaiFactory.
TILDAI_FACTORY=
# Red de la factory: 42220 (Celo mainnet) o 11142220 (Celo Sepolia).
TILDAI_CHAIN_ID=
# RPC opcional (sin valor, el RPC público de la red).
TILDAI_RPC_URL=
# Solo desarrollo local: 1 permite cualquier vault sin consultar la cadena.
TILDAI_DEMO=
# x402: API key del facilitador (x402.celo.org). Solo en el servidor, nunca en el navegador.
X402_API_KEY=
# x402: URL del facilitador (sin valor, https://api.x402.celo.org).
X402_FACILITATOR_URL=
